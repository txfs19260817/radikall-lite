{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
	"rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "lib/**/*.ts",
    "src/**/*.ts",
    "adapters/**/*.ts",
    "api/**/*.ts",
    "netlify/**/*.ts",
    "test/**/*.ts"
  ]
}
