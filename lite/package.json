{
  "name": "radikall-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env adapters/node.ts",
    "dev": "npm run build && node --env-file-if-exists=.env --watch adapters/node.ts",
    "test": "node --test test/*.test.ts && npm run test:ui",
    "check": "tsc --noEmit",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "test:ui": "node test/ui.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0",
    "happy-dom": "20.8.4"
  }
}
